{
  "name": "dsh-custom-background",
  "version": "0.1.1",
  "description": "Background image with site-wide frosted glass for the DeepSeek Harness web GUI",
  "type": "module",
  "main": "lib/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ai-written/dsh-custom-background.git"
  },
  "homepage": "https://github.com/ai-written/dsh-custom-background#readme",
  "bugs": {
    "url": "https://github.com/ai-written/dsh-custom-background/issues"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "engines": {
    "node": ">=22.15"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "background",
    "wallpaper",
    "glass"
  ],
  "license": "MIT",
  "scripts": {
    "test": "node test/manifest.mjs && node test/client.mjs",
    "prepublishOnly": "npm test"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.4"
  },
  "devDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
